{
  "name": "solana-alert-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/startup.ts",
    "start": "tsx src/productionStartup.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "release:check": "tsx scripts/releaseSafetyCheck.ts",
    "audit:alert-quality": "tsx scripts/analyzeUserFacingAlertQuality.ts",
    "pons:backfill-devs": "tsx scripts/backfillPonsDeveloperLaunches.ts",
    "pons:dev-report": "tsx scripts/reportPonsDevelopers.ts",
    "pons:outcome-report": "tsx scripts/reportPonsOutcomes.ts",
    "pons:collect-outcomes": "tsx scripts/collectPonsOutcomes.ts",
    "pons:refresh-dev-registry": "tsx scripts/refreshPonsDeveloperRegistry.ts",
    "pons:live-dev": "node --import tsx scripts/probePrebondWorker.ts 0x33d23702096327dfce561f0de3c3cbf98f8b2226 0x2f1548c8818d673bbb16d783d4b382f348227801 0xf3ef6ca6202264a30b37adc6b9230cacd07d1473; tsx scripts/runPonsLiveDev.ts",
    "pons:learn-devs": "tsx scripts/learnPonsDevelopers.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.103.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "redis": "^5.8.2",
    "sharp": "0.35.5",
    "telegraf": "^4.16.3",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^24.13.2",
    "tsx": "4.23.15",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@solana/web3.js": {
      "jayson": "5.0.0"
    }
  }
}
